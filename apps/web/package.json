{
  "name": "@app/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run docs:index && next build && opennextjs-cloudflare build --skipBuild --skipWranglerConfigCheck && node scripts/populate-static-assets-cache.mjs",
    "start": "next start",
    "preview": "opennextjs-cloudflare preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"./**/*.{js,jsx,ts,tsx,css,md,json}\"",
    "docs:index": "tsx scripts/build-docs-index.ts",
    "docs:index:check": "tsx scripts/build-docs-index.ts --check",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "endOfLine": "lf"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.100",
    "@ai-sdk/react": "^2.0.76",
    "@opennextjs/cloudflare": "^1.20.11",
    "@radix-ui/react-dialog": "1.0.3",
    "@radix-ui/react-label": "2.0.1",
    "ai": "^5.0.70",
    "class-variance-authority": "0.4.0",
    "clsx": "1.2.1",
    "cmdk": "0.2.0",
    "common-tags": "1.8.2",
    "lucide-react": "0.128.0",
    "next": "16.3.8",
    "postgres": "^3.4.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "1.10.0",
    "tailwindcss-animate": "1.0.5",
    "workers-ai-provider": "^2.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/common-tags": "1.8.1",
    "@types/estree": "1.0.0",
    "@types/mdast": "3.0.11",
    "@types/node": "^22.10.2",
    "@types/react": "18.0.30",
    "@types/react-dom": "18.0.11",
    "autoprefixer": "10.4.14",
    "eslint": "^9.27.0",
    "eslint-config-next": "16.3.8",
    "github-slugger": "2.0.0",
    "gpt3-tokenizer": "1.1.5",
    "mdast-util-from-markdown": "1.3.0",
    "mdast-util-mdx": "2.0.1",
    "mdast-util-to-markdown": "1.5.0",
    "mdast-util-to-string": "3.1.1",
    "micromark-extension-mdxjs": "1.0.0",
    "postcss": "8.4.31",
    "prettier": "2.8.7",
    "tailwindcss": "3.2.7",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "unist-builder": "3.0.1",
    "unist-util-filter": "4.0.1",
    "wrangler": "^4.151.0"
  }
}
